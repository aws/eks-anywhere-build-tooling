+*/
+
+package version
+
+import "testing"
+
+func TestMatchesMachineVersion(t *testing.T) {
+	tests := []struct {
+		name    string
+		node    string
+		machine string
+		want    bool
+	}{
+		{"same upstream version", "v1.37.1", "v1.37.1", true},
+		{"same prerelease", "v1.37.1-rc.1", "v1.37.1-rc.1", true},
+		{"EKS-D commit and release", "v1.37.1-eks-abcdef1", "v1.37.1-eks-1-37-4", true},
+		{"older supported series", "v1.31.14-eks-abcdef1", "v1.31.14-eks-1-31-51", true},
+		{"full source hash", "v1.37.1-eks-0123456789abcdef0123456789abcdef01234567", "v1.37.1-eks-1-37-4", true},
+		{"patch version differs", "v1.37.0-eks-abcdef1", "v1.37.1-eks-1-37-4", false},
+		{"minor version differs", "v1.36.1-eks-abcdef1", "v1.37.1-eks-1-37-4", false},
+		{"major version differs", "v2.37.1-eks-abcdef1", "v1.37.1-eks-1-37-4", false},
+		{"prerelease differs", "v1.37.1-rc.1", "v1.37.1", false},
+		{"another distribution", "v1.37.1-vendor-abcdef1", "v1.37.1-eks-1-37-4", false},
+		{"different EKS-D releases", "v1.37.1-eks-1-37-3", "v1.37.1-eks-1-37-4", false},
+		{"different source hashes", "v1.37.1-eks-abcdef1", "v1.37.1-eks-abcdef2", false},
+		{"wrong release series", "v1.37.1-eks-abcdef1", "v1.37.1-eks-1-36-4", false},
+		{"malformed source hash", "v1.37.1-eks-not-a-hash", "v1.37.1-eks-1-37-4", false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := MatchesMachineVersion(tt.node, tt.machine); got != tt.want {
+				t.Fatalf("MatchesMachineVersion(%q, %q)=%t, want %t", tt.node, tt.machine, got, tt.want)
+			}
+		})
+	}
+}

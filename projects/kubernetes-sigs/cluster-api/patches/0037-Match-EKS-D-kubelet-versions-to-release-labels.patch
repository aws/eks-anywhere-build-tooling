+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package version
+
+import "regexp"
+
+var (
+	eksDNodeVersion    = regexp.MustCompile(`^v?([0-9]+)\.([0-9]+)\.([0-9]+)-eks-[0-9a-f]{7,40}$`)
+	eksDReleaseVersion = regexp.MustCompile(`^v?([0-9]+)\.([0-9]+)\.([0-9]+)-eks-([0-9]+)-([0-9]+)-[0-9]+$`)
+)
+
+// MatchesMachineVersion compares an observed kubelet version with the desired Machine version.
+func MatchesMachineVersion(kubeletVersion, machineVersion string) bool {
+	if kubeletVersion == machineVersion {
+		return true
+	}
+
+	// EKS-D nodes report a source commit, while Machine versions identify an EKS-D release.
+	// Desired Machine/template comparisons still decide which release must be rolled out.
+	node := eksDNodeVersion.FindStringSubmatch(kubeletVersion)
+	release := eksDReleaseVersion.FindStringSubmatch(machineVersion)
+	if node == nil || release == nil {
+		return false
+	}
+	return node[1] == release[1] && node[2] == release[2] && node[3] == release[3] &&
+		release[1] == release[4] && release[2] == release[5]
+}

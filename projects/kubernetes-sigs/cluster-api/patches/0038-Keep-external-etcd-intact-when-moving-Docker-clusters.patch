From 0ac0c8b8bf3d9b62c03ee2468a332f6f056efcb4 Mon Sep 17 00:00:00 2001
From: Rahul Ganesh <rahulbabu95@gmail.com>
Date: Mon, 2 Nov 2026 22:02:27 +0000
Subject: [PATCH 38/38] Keep external etcd intact when moving Docker clusters

Recognize completed bootstrap before running it again after a move. Reinitializing an existing external etcd member loses cluster data.
---
 .../docker/internal/docker/machine.go         |  4 +-
 .../docker/internal/docker/machine_test.go    | 93 +++++++++++++++++++
 2 files changed, 96 insertions(+), 1 deletion(-)
 create mode 100644 test/infrastructure/docker/internal/docker/machine_test.go

diff --git a/test/infrastructure/docker/internal/docker/machine.go b/test/infrastructure/docker/internal/docker/machine.go
index 52495e0..34aff22 100644
--- a/test/infrastructure/docker/internal/docker/machine.go
+++ b/test/infrastructure/docker/internal/docker/machine.go
@@ -434,7 +434,9 @@ func (m *Machine) CheckForSentinelFile(ctx context.Context) (bool, error) {
 
 	var outErr bytes.Buffer
 	var outStd bytes.Buffer
-	cmd := m.container.Commander.Command("/bin/sh", "-c", "test -f /run/cluster-api/capd.bootstrap.started && echo \"true\" || echo \"false\"")
+	// External etcd bootstrap writes the completion marker without running kubeadm.
+	// Recognize it after move so an existing etcd member is not initialized again.
+	cmd := m.container.Commander.Command("/bin/sh", "-c", "(test -f /run/cluster-api/capd.bootstrap.started || test -f /run/cluster-api/bootstrap-success.complete) && echo \"true\" || echo \"false\"")
 	cmd.SetStderr(&outErr)
 	cmd.SetStdout(&outStd)
 	if err := cmd.Run(ctx); err != nil {
diff --git a/test/infrastructure/docker/internal/docker/machine_test.go b/test/infrastructure/docker/internal/docker/machine_test.go
new file mode 100644
index 0000000..8aa63a5
--- /dev/null
+++ b/test/infrastructure/docker/internal/docker/machine_test.go
@@ -0,0 +1,93 @@

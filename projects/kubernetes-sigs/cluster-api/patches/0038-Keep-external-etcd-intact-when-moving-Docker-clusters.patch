+package docker
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	. "github.com/onsi/gomega"
+
+	"sigs.k8s.io/cluster-api/test/infrastructure/container"
+	"sigs.k8s.io/cluster-api/test/infrastructure/docker/internal/docker/types"
+)
+
+func TestCheckForSentinelFile(t *testing.T) {
+	tests := []struct {
+		name    string
+		markers []string
+		want    bool
+	}{
+		{name: "new machine"},
+		{name: "kubeadm bootstrap started", markers: []string{"capd.bootstrap.started"}, want: true},
+		{name: "external etcd bootstrap completed", markers: []string{"bootstrap-success.complete"}, want: true},
+		{name: "both markers", markers: []string{"capd.bootstrap.started", "bootstrap-success.complete"}, want: true},
+		{name: "placeholder does not mark completion", markers: []string{"placeholder"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			g := NewWithT(t)
+			dir := t.TempDir()
+			for _, marker := range tt.markers {
+				g.Expect(os.WriteFile(filepath.Join(dir, marker), []byte("success"), 0600)).To(Succeed())
+			}
+			ctx := container.RuntimeInto(context.Background(), &sentinelRuntime{dir: dir})
+			m := &Machine{container: types.NewNode("test-machine", "test-image", "test-role")}
+			got, err := m.CheckForSentinelFile(ctx)
+			g.Expect(err).NotTo(HaveOccurred())
+			g.Expect(got).To(Equal(tt.want))
+		})
+	}
+}
+
+func TestCheckForSentinelFileErrors(t *testing.T) {
+	g := NewWithT(t)
+	_, err := (&Machine{}).CheckForSentinelFile(context.Background())
+	g.Expect(err).To(HaveOccurred())
+
+	runtimeErr := errors.New("container unavailable")
+	ctx := container.RuntimeInto(context.Background(), &sentinelRuntime{err: runtimeErr})
+	m := &Machine{container: types.NewNode("test-machine", "test-image", "test-role")}
+	_, err = m.CheckForSentinelFile(ctx)
+	g.Expect(errors.Is(err, runtimeErr)).To(BeTrue())
+}
+
+// Execute the container's probe against real marker files without requiring Docker.
+type sentinelRuntime struct {
+	container.FakeRuntime
+	dir string
+	err error
+}
+
+func (r *sentinelRuntime) ExecContainer(ctx context.Context, _ string, config *container.ExecContainerInput, command string, args ...string) error {
+	if r.err != nil {
+		return r.err
+	}
+	localArgs := make([]string, len(args))
+	for i, arg := range args {
+		localArgs[i] = strings.ReplaceAll(arg, "/run/cluster-api", r.dir)
+	}
+	cmd := exec.CommandContext(ctx, command, localArgs...)
+	cmd.Stdout = config.OutputBuffer
+	cmd.Stderr = config.ErrorBuffer
+	return cmd.Run()
+}

From fbf6106f056ceda52450067b9347f5f3ec559cf2 Mon Sep 17 00:00:00 2001
From: rajeshvenkata <rajesh.venkat.p@gmail.com>
Date: Thu, 30 Oct 2025 14:51:59 -0700
Subject: [PATCH 36/37] Fix KubeadmControlPlane webhook to properly default
 rollout


diff --git a/controlplane/kubeadm/webhooks/admission/kubeadmcontrolplane.go b/controlplane/kubeadm/webhooks/admission/kubeadmcontrolplane.go
index c7ca709c39cd..39714cad5c6d 100644
--- a/controlplane/kubeadm/webhooks/admission/kubeadmcontrolplane.go
+++ b/controlplane/kubeadm/webhooks/admission/kubeadmcontrolplane.go
@@ -75,8 +75,12 @@ func (webhook *KubeadmControlPlane) Default(_ context.Context, k *controlplanev1
 	}
 
 	// Enforce RollingUpdate strategy and default MaxSurge if not set.
-	k.Spec.Rollout.Strategy.Type = controlplanev1.RollingUpdateStrategyType
-	k.Spec.Rollout.Strategy.RollingUpdate.MaxSurge = intstr.ValueOrDefault(k.Spec.Rollout.Strategy.RollingUpdate.MaxSurge, intstr.FromInt32(1))
+	if k.Spec.Rollout.Strategy.Type == "" {
+		k.Spec.Rollout.Strategy.Type = controlplanev1.RollingUpdateStrategyType
+	}
+	if k.Spec.Rollout.Strategy.Type == controlplanev1.RollingUpdateStrategyType {
+		k.Spec.Rollout.Strategy.RollingUpdate.MaxSurge = intstr.ValueOrDefault(k.Spec.Rollout.Strategy.RollingUpdate.MaxSurge, intstr.FromInt32(1))
+	}
 	return nil
 }
 

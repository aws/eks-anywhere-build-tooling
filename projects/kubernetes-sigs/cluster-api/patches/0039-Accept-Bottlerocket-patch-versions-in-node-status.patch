diff --git a/util/version/eksd.go b/util/version/eksd.go
index 07bcc546571a..cfc9bbfaa533 100644
--- a/util/version/eksd.go
+++ b/util/version/eksd.go
@@ -16,7 +16,10 @@ limitations under the License.
 
 package version
 
-import "regexp"
+import (
+	"regexp"
+	"strings"
+)
 
 var (
 	eksDNodeVersion    = regexp.MustCompile(`^v?([0-9]+)\.([0-9]+)\.([0-9]+)-eks-[0-9a-f]{7,40}$`)
@@ -39,3 +42,20 @@ func MatchesMachineVersion(kubeletVersion, machineVersion string) bool {
 	return node[1] == release[1] && node[2] == release[2] && node[3] == release[3] &&
 		release[1] == release[4] && release[2] == release[5]
 }
+
+// MatchesObservedVersion allows Bottlerocket's independently released Kubernetes patch version.
+// Machine and template versions still determine which desired release must be rolled out.
+func MatchesObservedVersion(kubeletVersion, machineVersion, osImage string) bool {
+	if MatchesMachineVersion(kubeletVersion, machineVersion) {
+		return true
+	}
+	if !strings.HasPrefix(osImage, "Bottlerocket OS ") {
+		return false
+	}
+
+	node := eksDNodeVersion.FindStringSubmatch(kubeletVersion)
+	release := eksDReleaseVersion.FindStringSubmatch(machineVersion)
+	return node != nil && release != nil &&
+		node[1] == release[1] && node[2] == release[2] &&
+		release[1] == release[4] && release[2] == release[5]
+}

+func TestIsMachineDeploymentUpgradingBottlerocketVersion(t *testing.T) {
+	const desired = "v1.37.1-eks-1-37-4"
+	tests := []struct {
+		name    string
+		osImage string
+		node    string
+		machine string
+		want    bool
+	}{
+		{"Bottlerocket patch skew", "Bottlerocket OS 1.68.0", "v1.37.0-eks-abcdef1", desired, false},
+		{"Ubuntu patch skew", "Ubuntu 22.04.5 LTS", "v1.37.0-eks-abcdef1", desired, true},
+		{"Bottlerocket minor skew", "Bottlerocket OS 1.68.0", "v1.36.0-eks-abcdef1", desired, true},
+		{"desired Machine version still old", "Bottlerocket OS 1.68.0", "v1.37.0-eks-abcdef1", "v1.37.0-eks-1-37-3", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			g := NewWithT(t)
+			scheme := runtime.NewScheme()
+			g.Expect(clusterv1.AddToScheme(scheme)).To(Succeed())
+			md := &clusterv1.MachineDeployment{ObjectMeta: metav1.ObjectMeta{Name: "deployment", Namespace: "default"},
+				Spec: clusterv1.MachineDeploymentSpec{Template: clusterv1.MachineTemplateSpec{Spec: clusterv1.MachineSpec{Version: desired}}}}
+			m := &clusterv1.Machine{ObjectMeta: metav1.ObjectMeta{Name: "worker", Namespace: "default"},
+				Spec:   clusterv1.MachineSpec{Version: tt.machine},
+				Status: clusterv1.MachineStatus{NodeInfo: &corev1.NodeSystemInfo{KubeletVersion: tt.node, OSImage: tt.osImage}}}
+			c := fake.NewClientBuilder().WithScheme(scheme).WithObjects(m).Build()
+			got, err := IsMachineDeploymentUpgrading(context.Background(), c, md)
+			g.Expect(err).ToNot(HaveOccurred())
+			g.Expect(got).To(Equal(tt.want))
+		})
+	}
+}

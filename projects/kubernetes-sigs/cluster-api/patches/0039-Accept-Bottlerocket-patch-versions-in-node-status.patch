+func TestSetUpToDateConditionBottlerocketVersion(t *testing.T) {
+	const desired = "v1.37.1-eks-1-37-4"
+	tests := []struct {
+		name       string
+		osImage    string
+		node       string
+		machineSet string
+		updating   bool
+		want       metav1.ConditionStatus
+	}{
+		{"Bottlerocket patch skew", "Bottlerocket OS 1.68.0", "v1.37.0-eks-abcdef1", desired, false, metav1.ConditionTrue},
+		{"Ubuntu patch skew", "Ubuntu 22.04.5 LTS", "v1.37.0-eks-abcdef1", desired, false, metav1.ConditionFalse},
+		{"Bottlerocket minor skew", "Bottlerocket OS 1.68.0", "v1.36.0-eks-abcdef1", desired, false, metav1.ConditionFalse},
+		{"desired MachineSet still old", "Bottlerocket OS 1.68.0", "v1.37.0-eks-abcdef1", "v1.37.0-eks-1-37-3", false, metav1.ConditionFalse},
+		{"in-place update still running", "Bottlerocket OS 1.68.0", "v1.37.0-eks-abcdef1", desired, true, metav1.ConditionFalse},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			g := NewWithT(t)
+			md := &clusterv1.MachineDeployment{Spec: clusterv1.MachineDeploymentSpec{
+				Template: clusterv1.MachineTemplateSpec{Spec: clusterv1.MachineSpec{Version: desired}},
+			}}
+			ms := &clusterv1.MachineSet{Spec: clusterv1.MachineSetSpec{
+				Template: clusterv1.MachineTemplateSpec{Spec: clusterv1.MachineSpec{Version: tt.machineSet}},
+			}}
+			m := &clusterv1.Machine{Spec: clusterv1.MachineSpec{Version: tt.machineSet},
+				Status: clusterv1.MachineStatus{NodeInfo: &corev1.NodeSystemInfo{KubeletVersion: tt.node, OSImage: tt.osImage}}}
+			if tt.updating {
+				conditions.Set(m, metav1.Condition{Type: clusterv1.MachineUpdatingCondition, Status: metav1.ConditionTrue, Reason: clusterv1.MachineInPlaceUpdatingReason})
+			}
+			setUpToDateCondition(context.Background(), m, ms, md)
+			condition := conditions.Get(m, clusterv1.MachineUpToDateCondition)
+			g.Expect(condition).ToNot(BeNil())
+			g.Expect(condition.Status).To(Equal(tt.want))
+		})
+	}
+}

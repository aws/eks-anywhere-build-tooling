+func TestReconcileMachineUpToDateBottlerocketVersion(t *testing.T) {
+	const desired = "v1.37.1-eks-1-37-4"
+	tests := []struct {
+		name       string
+		osImage    string
+		node       string
+		notCurrent bool
+		updating   bool
+		want       metav1.ConditionStatus
+	}{
+		{"Bottlerocket patch skew", "Bottlerocket OS 1.68.0", "v1.37.0-eks-abcdef1", false, false, metav1.ConditionTrue},
+		{"Ubuntu patch skew", "Ubuntu 22.04.5 LTS", "v1.37.0-eks-abcdef1", false, false, metav1.ConditionFalse},
+		{"Bottlerocket minor skew", "Bottlerocket OS 1.68.0", "v1.36.0-eks-abcdef1", false, false, metav1.ConditionFalse},
+		{"desired template still old", "Bottlerocket OS 1.68.0", "v1.37.0-eks-abcdef1", true, false, metav1.ConditionFalse},
+		{"in-place update still running", "Bottlerocket OS 1.68.0", "v1.37.0-eks-abcdef1", false, true, metav1.ConditionFalse},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			g := NewWithT(t)
+			m := &clusterv1.Machine{ObjectMeta: metav1.ObjectMeta{Name: "control-plane"},
+				Spec:   clusterv1.MachineSpec{Version: desired},
+				Status: clusterv1.MachineStatus{NodeInfo: &corev1.NodeSystemInfo{KubeletVersion: tt.node, OSImage: tt.osImage}}}
+			cp := &pkg.ControlPlane{
+				KCP:      &controlplanev1.KubeadmControlPlane{Spec: controlplanev1.KubeadmControlPlaneSpec{Version: desired}},
+				Machines: collections.FromMachines(m),
+			}
+			if tt.notCurrent {
+				cp.MachinesNotUpToDate = collections.FromMachines(m)
+			}
+			if tt.updating {
+				m.Annotations = map[string]string{clusterv1.UpdateInProgressAnnotation: ""}
+				conditions.Set(m, metav1.Condition{Type: clusterv1.MachineUpdatingCondition, Status: metav1.ConditionTrue, Reason: clusterv1.MachineInPlaceUpdatingReason})
+			}
+			reconcileMachineUpToDateCondition(context.Background(), cp)
+			condition := conditions.Get(m, clusterv1.MachineUpToDateCondition)
+			g.Expect(condition).ToNot(BeNil())
+			g.Expect(condition.Status).To(Equal(tt.want))
+		})
+	}
+}

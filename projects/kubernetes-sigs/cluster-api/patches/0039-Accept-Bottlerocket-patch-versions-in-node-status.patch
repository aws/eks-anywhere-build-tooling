+func TestMatchesObservedVersion(t *testing.T) {
+	tests := []struct {
+		name    string
+		node    string
+		machine string
+		osImage string
+		want    bool
+	}{
+		{"Bottlerocket older patch", "v1.37.0-eks-abcdef1", "v1.37.1-eks-1-37-4", "Bottlerocket OS 1.68.0 (vmware-k8s-1.37)", true},
+		{"Bottlerocket newer patch", "v1.37.2-eks-abcdef1", "v1.37.1-eks-1-37-4", "Bottlerocket OS 1.68.0 (vmware-k8s-1.37)", true},
+		{"Bottlerocket matching patch", "v1.37.1-eks-abcdef1", "v1.37.1-eks-1-37-4", "Bottlerocket OS 1.68.0", true},
+		{"Ubuntu older patch", "v1.37.0-eks-abcdef1", "v1.37.1-eks-1-37-4", "Ubuntu 22.04.5 LTS", false},
+		{"Red Hat older patch", "v1.37.0-eks-abcdef1", "v1.37.1-eks-1-37-4", "Red Hat Enterprise Linux 9.6", false},
+		{"unknown OS older patch", "v1.37.0-eks-abcdef1", "v1.37.1-eks-1-37-4", "", false},
+		{"similar OS name", "v1.37.0-eks-abcdef1", "v1.37.1-eks-1-37-4", "Other Bottlerocket OS 1.68.0", false},
+		{"Bottlerocket different minor", "v1.36.0-eks-abcdef1", "v1.37.1-eks-1-37-4", "Bottlerocket OS 1.68.0", false},
+		{"Bottlerocket different major", "v2.37.0-eks-abcdef1", "v1.37.1-eks-1-37-4", "Bottlerocket OS 1.68.0", false},
+		{"Bottlerocket wrong release branch", "v1.37.0-eks-abcdef1", "v1.37.1-eks-1-36-4", "Bottlerocket OS 1.68.0", false},
+		{"Bottlerocket upstream versions", "v1.37.0", "v1.37.1", "Bottlerocket OS 1.68.0", false},
+		{"Bottlerocket malformed node suffix", "v1.37.0-eks-not-a-hash", "v1.37.1-eks-1-37-4", "Bottlerocket OS 1.68.0", false},
+		{"generic identical version", "v1.37.1", "v1.37.1", "Ubuntu 22.04.5 LTS", true},
+		{"generic EKS-D alias", "v1.37.1-eks-abcdef1", "v1.37.1-eks-1-37-4", "Ubuntu 22.04.5 LTS", true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := MatchesObservedVersion(tt.node, tt.machine, tt.osImage); got != tt.want {
+				t.Fatalf("MatchesObservedVersion(%q, %q, %q)=%t, want %t", tt.node, tt.machine, tt.osImage, got, tt.want)
+			}
+		})
+	}
+}

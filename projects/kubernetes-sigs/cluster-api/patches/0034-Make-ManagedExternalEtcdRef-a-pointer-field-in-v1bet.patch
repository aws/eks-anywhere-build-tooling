diff --git a/api/core/v1beta1/conversion.go b/api/core/v1beta1/conversion.go
index 2034c45e154b..4294852e3381 100644
--- a/api/core/v1beta1/conversion.go
+++ b/api/core/v1beta1/conversion.go
@@ -17,6 +17,7 @@ limitations under the License.
 package v1beta1
 
 import (
+	"fmt"
 	"maps"
 	"reflect"
 	"slices"
@@ -26,6 +27,7 @@ import (
 	corev1 "k8s.io/api/core/v1"
 	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
 	apimachineryconversion "k8s.io/apimachinery/pkg/conversion"
+	"k8s.io/apimachinery/pkg/runtime/schema"
 
 	clusterv1 "sigs.k8s.io/cluster-api/api/core/v1beta2"
 )
@@ -1597,6 +1599,24 @@ func Convert_v1beta1_ClusterSpec_To_v1beta2_ClusterSpec(in *ClusterSpec, out *cl
 	if err := autoConvert_v1beta1_ClusterSpec_To_v1beta2_ClusterSpec(in, out, s); err != nil {
 		return err
 	}
+	// ManagedExternalEtcdRef is an EKS-A field; v1beta2 stores it as a ContractVersionedObjectReference.
+	// Convert from the v1beta1 ObjectReference (APIVersion -> APIGroup; version is re-resolved from the
+	// contract downstream). Mirrors convertToContractVersionedObjectReference in core/webhooks/conversion.
+	if in.ManagedExternalEtcdRef != nil {
+		var apiGroup string
+		if in.ManagedExternalEtcdRef.APIVersion != "" {
+			gv, err := schema.ParseGroupVersion(in.ManagedExternalEtcdRef.APIVersion)
+			if err != nil {
+				return fmt.Errorf("failed to parse ManagedExternalEtcdRef apiVersion: %w", err)
+			}
+			apiGroup = gv.Group
+		}
+		out.ManagedExternalEtcdRef = &clusterv1.ContractVersionedObjectReference{
+			APIGroup: apiGroup,
+			Kind:     in.ManagedExternalEtcdRef.Kind,
+			Name:     in.ManagedExternalEtcdRef.Name,
+		}
+	}
 	if in.ClusterNetwork != nil {
 		if err := Convert_v1beta1_ClusterNetwork_To_v1beta2_ClusterNetwork(in.ClusterNetwork, &out.ClusterNetwork, s); err != nil {
 			return err

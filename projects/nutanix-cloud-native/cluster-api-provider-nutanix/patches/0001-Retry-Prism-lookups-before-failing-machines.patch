From: Rahul Ganesh <rahulbabu95@gmail.com>
Date: Fri, 6 Nov 2026 23:59:14 +0000
Subject: [PATCH] Retry Prism lookups before failing machines

---
 controllers/nutanixmachine_controller.go    |   4 +-
 controllers/nutanixmachine_recovery_test.go | 110 ++++++++++++++++++++
 2 files changed, 113 insertions(+), 1 deletion(-)
 create mode 100644 controllers/nutanixmachine_recovery_test.go

diff --git a/controllers/nutanixmachine_controller.go b/controllers/nutanixmachine_controller.go
index a9dbbea3bf19..0940288b9fe8 100644
--- a/controllers/nutanixmachine_controller.go
+++ b/controllers/nutanixmachine_controller.go
@@ -1357,7 +1357,9 @@ func (r *NutanixMachineReconciler) getOrCreateVM(rctx *nctx.MachineContext) (*vm
 	peUUID, subnetUUIDs, err := r.GetSubnetAndPEUUIDs(rctx)
 	if err != nil {
 		log.Error(err, fmt.Sprintf("failed to get the config for VM %s.", vmName))
-		rctx.SetFailureStatus(createErrorFailureReason, err)
+		if !isRetryableAPIError(err) {
+			rctx.SetFailureStatus(createErrorFailureReason, err)
+		}
 		return nil, err
 	}
 
diff --git a/controllers/nutanixmachine_recovery_test.go b/controllers/nutanixmachine_recovery_test.go
new file mode 100644
index 000000000000..ff936b046a98
--- /dev/null
+++ b/controllers/nutanixmachine_recovery_test.go
@@ -0,0 +1,110 @@

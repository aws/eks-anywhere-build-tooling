+type recordingHandler struct {
+	handle func(context.Context)
+}
+
+func (r recordingHandler) Handle(ctx context.Context, _ net.PacketConn, _ net.Addr, _ dhcpv6.DHCPv6) {
+	if r.handle != nil {

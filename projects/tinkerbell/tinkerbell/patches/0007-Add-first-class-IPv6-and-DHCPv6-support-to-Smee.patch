+const (
+	UnknownArch = iana.Arch(255)
+
+	// ClientEnterpriseNumber identifies Tinkerbell vendor-class responses.
+	ClientEnterpriseNumber = 343 // Uses Intel number to work with IPv6 EDK II UEFI
+)

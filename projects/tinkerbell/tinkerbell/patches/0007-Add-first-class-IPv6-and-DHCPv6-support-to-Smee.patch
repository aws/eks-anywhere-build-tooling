+func TestHandleNestedRelayInformationRequestUsesInnermostRelayMAC(t *testing.T) {
+	mac := net.HardwareAddr{0, 1, 2, 3, 4, 5}
+	outerMAC := net.HardwareAddr{0, 1, 2, 3, 4, 6}
+	handler := newHandler(t, map[string]*tinkerbell.Hardware{

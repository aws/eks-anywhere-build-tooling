+func (m *mockBackend) FilterHardware(_ context.Context, opts data.HardwareFilter) (*tinkerbell.Hardware, error) {
+	if m.err != nil {
+		return nil, m.err
+	}
+	hw, ok := m.hardware[opts.ByMACAddress]
+	if !ok {
+		return nil, hardwareNotFoundError{}
+	}
+	return hw, nil
+}

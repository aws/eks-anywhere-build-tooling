+func TestInstanceEndpointReturnsMetadataWhenAddressObservationFails(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	client := ec2.NewMockClient(ctrl)
+	client.EXPECT().
+		GetEC2InstanceByInstanceID(gomock.Any(), "instance-id-in-url").
+		Return(data.Ec2Instance{Metadata: data.Metadata{InstanceID: "instance-id-in-url"}}, nil)
+	client.EXPECT().
+		ObserveEC2InstanceAddress(gomock.Any(), "instance-id-in-url", "2001:db8::10").
+		Return(errors.New("update failed"))
+
+	router := gin.New()
+	fe := ec2.New(client, true)
+	fe.Configure(router)
+
+	w := httptest.NewRecorder()
+	r := httptest.NewRequest("GET", "/tootles/instanceID/instance-id-in-url/2009-04-04/meta-data/instance-id", nil)
+	r.RemoteAddr = "[2001:db8::10]:1234"
+
+	router.ServeHTTP(w, r)
+
+	if w.Code != http.StatusOK {
+		t.Fatalf("expected status 200, got %d", w.Code)
+	}
+	if w.Body.String() != "instance-id-in-url" {
+		t.Fatalf("expected instance ID response, got %q", w.Body.String())
+	}
+}

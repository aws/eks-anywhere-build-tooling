+func TestObserveEC2InstanceAddress(t *testing.T) {
+	hw := &v1alpha1.Hardware{}
+	reader := &mockReader{hw: hw}
+	b := New(reader, reader)
+
+	if err := b.ObserveEC2InstanceAddress(context.Background(), "instance-1", "2001:db8::10"); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if reader.filterOpts.ByInstanceID != "instance-1" {
+		t.Fatalf("expected instance ID filter, got %#v", reader.filterOpts)
+	}
+	if reader.updateCalls != 1 {
+		t.Fatalf("expected one update, got %d", reader.updateCalls)
+	}
+	if !reader.updateOpts.StatusOnly || reader.updateOpts.PatchFrom == nil {
+		t.Fatalf("expected status merge patch options, got %#v", reader.updateOpts)
+	}
+	want := []corev1.NodeAddress{{
+		Type:    corev1.NodeInternalIP,
+		Address: "2001:db8::10",
+	}}
+	if diff := cmp.Diff(want, reader.updated.Status.Addresses); diff != "" {
+		t.Fatalf("observed addresses mismatch (-want +got):\n%s", diff)
+	}
+}
+
+func TestObserveEC2InstanceAddressSkipsUnchangedAddress(t *testing.T) {
+	addresses := []corev1.NodeAddress{{
+		Type:    corev1.NodeInternalIP,
+		Address: "2001:db8::10",
+	}}
+	reader := &mockReader{
+		hw: &v1alpha1.Hardware{
+			Status: v1alpha1.HardwareStatus{Addresses: addresses},
+		},
+	}
+
+	if err := New(reader, reader).ObserveEC2InstanceAddress(context.Background(), "instance-1", "2001:db8::10"); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if reader.updateCalls != 0 {
+		t.Fatalf("expected no update, got %d", reader.updateCalls)
+	}
+}
+
+func TestObserveEC2InstanceAddressRejectsInvalidAddresses(t *testing.T) {
+	for _, address := range []string{"not-an-ip", "::", "::1", "fe80::1", "ff02::1"} {
+		t.Run(address, func(t *testing.T) {
+			reader := &mockReader{hw: &v1alpha1.Hardware{}}
+			err := New(reader, reader).ObserveEC2InstanceAddress(context.Background(), "instance-1", address)
+			if err == nil {
+				t.Fatal("expected error")
+			}
+			if reader.updateCalls != 0 {
+				t.Fatalf("expected no update, got %d", reader.updateCalls)
+			}
+		})
+	}
+}
+
+func TestObserveEC2InstanceAddressReturnsUpdateError(t *testing.T) {
+	reader := &mockReader{
+		hw:        &v1alpha1.Hardware{},
+		updateErr: errors.New("update failed"),
+	}
+
+	err := New(reader, reader).ObserveEC2InstanceAddress(context.Background(), "instance-1", "2001:db8::10")
+	if err == nil || err.Error() != "update failed" {
+		t.Fatalf("expected update error, got %v", err)
+	}
+}

 }
 
+// ObserveEC2InstanceAddress validates and persists the requester address.
+func (b *Backend) ObserveEC2InstanceAddress(ctx context.Context, instanceID, address string) error {
+	if b.updater == nil {
+		return errors.New("hardware backend does not support updates")
+	}
+
+	ip, err := netip.ParseAddr(strings.TrimSpace(address))
+	if err != nil || !ip.IsGlobalUnicast() {
+		return fmt.Errorf("invalid observed address %q", address)
+	}
+	ip = ip.Unmap()
+
+	hw, err := b.filterer.FilterHardware(ctx, data.HardwareFilter{ByInstanceID: instanceID})
+	if err != nil {
+		return toInstanceNotFoundErr(err)
+	}
+
+	addresses := []corev1.NodeAddress{{
+		Type:    corev1.NodeInternalIP,
+		Address: ip.String(),
+	}}
+	if slices.Equal(hw.Status.Addresses, addresses) {
+		return nil
+	}
+
+	original := hw.DeepCopy()
+	hw.Status.Addresses = addresses
+
+	return b.updater.UpdateHardware(ctx, hw, data.UpdateOptions{
+		StatusOnly: true,
+		PatchFrom:  original,
+	})
+}
+

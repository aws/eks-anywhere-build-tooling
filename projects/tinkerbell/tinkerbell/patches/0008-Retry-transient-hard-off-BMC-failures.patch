+package controller
+
+import (
+	"testing"
+
+	"github.com/tinkerbell/tinkerbell/api/v1alpha1/bmc"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"sigs.k8s.io/controller-runtime/pkg/event"
+)
+
+func TestTaskEventPredicate(t *testing.T) {
+	hardOff := bmc.PowerHardOff
+	powerOn := bmc.PowerOn
+
+	tests := map[string]struct {
+		oldTask *bmc.Task
+		newTask *bmc.Task
+		want    bool
+	}{
+		"hard-off status update is filtered": {
+			oldTask: taskForPredicate(1, hardOff),
+			newTask: taskForPredicate(1, hardOff),
+			want:    false,
+		},
+		"hard-off annotation update is filtered": {
+			oldTask: taskForPredicate(1, hardOff),
+			newTask: func() *bmc.Task {
+				task := taskForPredicate(1, hardOff)
+				task.Annotations = map[string]string{"example": "value"}
+				return task
+			}(),
+			want: false,
+		},
+		"hard-off spec update is accepted": {
+			oldTask: taskForPredicate(1, hardOff),
+			newTask: taskForPredicate(2, hardOff),
+			want:    true,
+		},
+		"other action status update is accepted": {
+			oldTask: taskForPredicate(1, powerOn),
+			newTask: taskForPredicate(1, powerOn),
+			want:    true,
+		},
+		"action change to hard-off is accepted": {
+			oldTask: taskForPredicate(1, powerOn),
+			newTask: taskForPredicate(2, hardOff),
+			want:    true,
+		},
+	}
+
+	predicate := taskEventPredicate()
+	for name, tt := range tests {
+		t.Run(name, func(t *testing.T) {
+			got := predicate.Update(event.UpdateEvent{
+				ObjectOld: tt.oldTask,
+				ObjectNew: tt.newTask,
+			})
+			if got != tt.want {
+				t.Fatalf("expected predicate result %t, got %t", tt.want, got)
+			}
+		})
+	}
+}
+
+func taskForPredicate(generation int64, powerAction bmc.PowerAction) *bmc.Task {
+	return &bmc.Task{
+		ObjectMeta: metav1.ObjectMeta{Generation: generation},
+		Spec: bmc.TaskSpec{
+			Task: bmc.Action{PowerAction: &powerAction},
+		},
+	}
+}

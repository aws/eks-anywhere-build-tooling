+func TestTaskReconcilePowerHardOffRecoversWithoutRecreatingTask(t *testing.T) {
+	secret := createSecret()
+	task := createTask("HardOff", getAction("HardOff"), secret)
+	provider := &testProvider{
+		Powerstate:         "on",
+		PowerstateAfterSet: "off",
+		PowerSetOK:         true,
+		ErrOpen:            errors.New("temporary connection failure"),
+	}
+	cluster := newClientBuilder().WithObjects(task, secret).Build()
+	reconciler := controller.NewTaskReconciler(cluster, newTestClient(provider))
+	request := reconcile.Request{NamespacedName: types.NamespacedName{Namespace: task.Namespace, Name: task.Name}}
+
+	result, err := reconciler.Reconcile(context.Background(), request)
+	if err != nil {
+		t.Fatalf("expected retry without reconcile error, got: %v", err)
+	}
+	if result.RequeueAfter == 0 {
+		t.Fatal("expected connection failure to be requeued")
+	}
+
+	provider.ErrOpen = nil
+	result, err = reconciler.Reconcile(context.Background(), request)
+	if err != nil {
+		t.Fatalf("expected recovered power-off attempt, got: %v", err)
+	}
+	if diff := cmp.Diff(result, ctrl.Result{RequeueAfter: 3 * time.Second}); diff != "" {
+		t.Fatalf("unexpected result after issuing hard-off (-want +got):\n%s", diff)
+	}
+	if provider.PowerSetCalls != 1 {
+		t.Fatalf("expected one power-off command, got %d", provider.PowerSetCalls)
+	}
+
+	retrieved := getTask(t, cluster, request.NamespacedName)
+	if _, ok := retrieved.Annotations["bmc.tinkerbell.org/hard-off-action-issued-at"]; !ok {
+		t.Fatalf("expected issued-at annotation, got: %+v", retrieved.Annotations)
+	}
+
+	result, err = reconciler.Reconcile(context.Background(), request)
+	if err != nil {
+		t.Fatalf("expected completed hard-off task, got: %v", err)
+	}
+	if diff := cmp.Diff(result, ctrl.Result{}); diff != "" {
+		t.Fatalf("unexpected completion result (-want +got):\n%s", diff)
+	}
+	if provider.PowerSetCalls != 1 {
+		t.Fatalf("expected no duplicate power-off command, got %d", provider.PowerSetCalls)
+	}
+
+	retrieved = getTask(t, cluster, request.NamespacedName)
+	assertTaskCondition(t, retrieved, bmc.TaskCompleted, bmc.ConditionTrue)
+	if condition := findTaskCondition(retrieved, bmc.TaskConditionType("Retrying")); condition != nil {
+		t.Fatalf("expected retrying condition to be cleared, got: %+v", *condition)
+	}
+	if _, ok := retrieved.Annotations["bmc.tinkerbell.org/hard-off-action-issued-at"]; ok {
+		t.Fatalf("expected issued-at annotation to be cleared, got: %+v", retrieved.Annotations)
+	}
+}

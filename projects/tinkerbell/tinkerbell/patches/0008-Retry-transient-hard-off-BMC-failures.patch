+func TestTaskReconcilePowerHardOffObservesBeforeResending(t *testing.T) {
+	tests := map[string]struct {
+		startTime       time.Time
+		issuedAt        *time.Time
+		expectRetrying  bool
+		expectImmediate time.Duration
+	}{
+		"within observation window": {
+			startTime:       time.Now().Add(-10 * time.Second),
+			issuedAt:        toPtr(time.Now().Add(-10 * time.Second)),
+			expectImmediate: 3 * time.Second,
+		},
+		"expired observation window": {
+			startTime:      time.Now().Add(-2 * time.Minute),
+			issuedAt:       toPtr(time.Now().Add(-2 * time.Minute)),
+			expectRetrying: true,
+		},
+		"task from older controller": {
+			startTime:       time.Now().Add(-10 * time.Second),
+			expectImmediate: 3 * time.Second,
+		},
+	}
+
+	for name, tt := range tests {
+		t.Run(name, func(t *testing.T) {
+			secret := createSecret()
+			task := createTask("HardOff", getAction("HardOff"), secret)
+			startTime := metav1.NewTime(tt.startTime)
+			task.Status.StartTime = &startTime
+			if tt.issuedAt != nil {
+				task.Annotations = map[string]string{
+					"bmc.tinkerbell.org/hard-off-action-issued-at": tt.issuedAt.UTC().Format(time.RFC3339Nano),
+				}
+			}
+			provider := &testProvider{Powerstate: "on", PowerSetOK: true}
+			cluster := newClientBuilder().WithObjects(task, secret).Build()
+			reconciler := controller.NewTaskReconciler(cluster, newTestClient(provider))
+			request := reconcile.Request{NamespacedName: types.NamespacedName{Namespace: task.Namespace, Name: task.Name}}
+
+			result, err := reconciler.Reconcile(context.Background(), request)
+			if err != nil {
+				t.Fatalf("expected nil err, got: %v", err)
+			}
+			if provider.PowerSetCalls != 0 {
+				t.Fatalf("expected no command during observation, got %d", provider.PowerSetCalls)
+			}
+			if tt.expectImmediate != 0 && result.RequeueAfter != tt.expectImmediate {
+				t.Fatalf("expected requeue after %s, got %s", tt.expectImmediate, result.RequeueAfter)
+			}
+			if tt.expectRetrying && result.RequeueAfter == 0 {
+				t.Fatal("expected expired observation to be requeued")
+			}
+
+			retrieved := getTask(t, cluster, request.NamespacedName)
+			retrying := findTaskCondition(retrieved, bmc.TaskConditionType("Retrying"))
+			if tt.expectRetrying && retrying == nil {
+				t.Fatalf("expected retrying condition, got: %+v", retrieved.Status.Conditions)
+			}
+			if !tt.expectRetrying && retrying != nil {
+				t.Fatalf("expected no retrying condition, got: %+v", *retrying)
+			}
+
+			if !tt.expectRetrying {
+				return
+			}
+
+			result, err = reconciler.Reconcile(context.Background(), request)
+			if err != nil {
+				t.Fatalf("expected retry to issue hard-off, got: %v", err)
+			}
+			if diff := cmp.Diff(result, ctrl.Result{RequeueAfter: 3 * time.Second}); diff != "" {
+				t.Fatalf("unexpected resend result (-want +got):\n%s", diff)
+			}
+			if provider.PowerSetCalls != 1 {
+				t.Fatalf("expected one power-off command after observation window, got %d", provider.PowerSetCalls)
+			}
+		})
+	}
+}

+func (r *TaskReconciler) reconcilePowerHardOff(ctx context.Context, task *bmc.Task, taskPatch client.Patch, logger logr.Logger) (ctrl.Result, error) {
+	hadStartTime := task.Status.StartTime != nil && !task.Status.StartTime.IsZero()
+	if !hadStartTime {
+		now := metav1.Now()
+		task.Status.StartTime = &now
+		if err := r.patchStatus(ctx, task, taskPatch); err != nil {
+			return ctrl.Result{}, err
+		}
+		taskPatch = client.MergeFrom(task.DeepCopy())
+	}
+
+	username, password, opts, err := r.resolveConnectionOptions(ctx, task)
+	if err != nil {
+		return r.retryPowerHardOff(ctx, task, taskPatch, logger, err)
+	}
+
+	bmcClient, err := r.bmcClientFactory(ctx, logger, task.Spec.Connection.Host, username, password, opts)
+	if err != nil {
+		return r.retryPowerHardOff(ctx, task, taskPatch, logger, fmt.Errorf("failed to connect to BMC: %w", err))
+	}
+	defer func() {
+		closeCtx, cancel := context.WithTimeout(ctx, hardOffOperationTimeout)
+		defer cancel()
+		r.closeBMCClient(closeCtx, logger, bmcClient)
+	}()
+
+	stateCtx, cancel := context.WithTimeout(ctx, hardOffOperationTimeout)
+	rawState, err := bmcClient.GetPowerState(stateCtx)
+	cancel()
+	if err != nil {
+		return r.retryPowerHardOff(ctx, task, taskPatch, logger, fmt.Errorf("failed to get power state: %w", err))
+	}
+
+	logger.Info("power state check", "currentPowerState", rawState)
+	if toPowerState(rawState) == bmc.Off {
+		if err := r.clearHardOffActionAttemptedAt(ctx, task); err != nil {
+			return ctrl.Result{}, err
+		}
+		taskPatch = client.MergeFrom(task.DeepCopy())
+		removeTaskCondition(task, taskRetryingCondition)
+		now := metav1.Now()
+		task.Status.CompletionTime = &now
+		task.SetCondition(bmc.TaskCompleted, bmc.ConditionTrue)
+		if err := r.patchStatus(ctx, task, taskPatch); err != nil {
+			return ctrl.Result{}, err
+		}
+
+		return ctrl.Result{}, nil
+	}
+
+	attemptedAt, actionAttempted, err := hardOffActionAttemptedAt(task)
+	if err != nil {
+		if clearErr := r.clearHardOffActionAttemptedAt(ctx, task); clearErr != nil {
+			return ctrl.Result{}, utilerrors.NewAggregate([]error{clearErr, err})
+		}
+		taskPatch = client.MergeFrom(task.DeepCopy())
+
+		return r.retryPowerHardOff(ctx, task, taskPatch, logger, err)
+	}
+
+	// A Task created by an older controller has no action annotation. Treat its
+	// StartTime as the attempt time so an in-flight hard-off is not immediately
+	// duplicated after an upgrade.
+	if !actionAttempted && hadStartTime && !task.HasCondition(taskRetryingCondition, bmc.ConditionTrue) {
+		attemptedAt = task.Status.StartTime.Time
+		if err := r.setHardOffActionAttemptedAt(ctx, task, attemptedAt); err != nil {
+			return ctrl.Result{}, err
+		}
+		actionAttempted = true
+	}
+
+	if actionAttempted {
+		if time.Since(attemptedAt) < hardOffActionObservationWindow {
+			return ctrl.Result{RequeueAfter: powerActionRequeueAfter}, nil
+		}
+
+		if err := r.clearHardOffActionAttemptedAt(ctx, task); err != nil {
+			return ctrl.Result{}, err
+		}
+		taskPatch = client.MergeFrom(task.DeepCopy())
+
+		return r.retryPowerHardOff(
+			ctx,
+			task,
+			taskPatch,
+			logger,
+			fmt.Errorf("power-off command was accepted but the machine is still powered on after %s", hardOffActionObservationWindow),
+		)
+	}
+
+	// Persist the attempt before invoking the BMC. If the process exits during
+	// the external call, the next reconcile observes the machine before it can
+	// issue another hard-off.
+	attemptedAt = time.Now()
+	if err := r.setHardOffActionAttemptedAt(ctx, task, attemptedAt); err != nil {
+		return ctrl.Result{}, err
+	}
+	taskPatch = client.MergeFrom(task.DeepCopy())
+
+	setCtx, cancel := context.WithTimeout(ctx, hardOffOperationTimeout)
+	ok, err := bmcClient.SetPowerState(setCtx, string(bmc.PowerHardOff))
+	cancel()
+	if err != nil {
+		return r.retryPowerHardOff(ctx, task, taskPatch, logger, fmt.Errorf("failed to perform PowerAction: %w", err))
+	}
+	if !ok {
+		return r.retryPowerHardOff(ctx, task, taskPatch, logger, errors.New("failed to perform PowerAction: provider returned ok=false"))
+	}
+
+	if removeTaskCondition(task, taskRetryingCondition) {
+		if err := r.patchStatus(ctx, task, taskPatch); err != nil {
+			return ctrl.Result{}, err
+		}
+	}
+
+	md := bmcClient.GetMetadata()
+	logger.Info("power state set successfully", "providersAttempted", md.ProvidersAttempted, "successfulProvider", md.SuccessfulProvider, "ok", ok)
+
+	return ctrl.Result{RequeueAfter: powerActionRequeueAfter}, nil
+}
+
+func (r *TaskReconciler) retryPowerHardOff(ctx context.Context, task *bmc.Task, taskPatch client.Patch, logger logr.Logger, retryErr error) (ctrl.Result, error) {
+	requeueAfter := hardOffRetryDelay(task, time.Now())
+	logger.Info("power-off attempt failed; requeuing", "error", retryErr, "requeueAfter", requeueAfter)
+	task.SetCondition(taskRetryingCondition, bmc.ConditionTrue, bmc.WithTaskConditionMessage(retryErr.Error()))
+	if err := r.patchStatus(ctx, task, taskPatch); err != nil {
+		return ctrl.Result{}, utilerrors.NewAggregate([]error{err, retryErr})
+	}
+
+	return ctrl.Result{RequeueAfter: requeueAfter}, nil
+}
+
+func (r *TaskReconciler) resolveConnectionOptions(ctx context.Context, task *bmc.Task) (string, string, *BMCOptions, error) {
+	var username, password string
+	opts := &BMCOptions{
+		ProviderOptions: task.Spec.Connection.ProviderOptions,
+	}
+	if task.Spec.Connection.ProviderOptions != nil && task.Spec.Connection.ProviderOptions.RPC != nil {
+		if task.Spec.Connection.ProviderOptions.RPC.HMAC != nil && len(task.Spec.Connection.ProviderOptions.RPC.HMAC.Secrets) > 0 {
+			se, err := retrieveHMACSecrets(ctx, r.client, task.Spec.Connection.ProviderOptions.RPC.HMAC.Secrets)
+			if err != nil {
+				return "", "", nil, fmt.Errorf("unable to get hmac secrets: %w", err)
+			}
+			opts.rpcSecrets = se
+		}
+	} else {
+		var err error
+		username, password, err = resolveAuthSecretRef(ctx, r.client, task.Spec.Connection.AuthSecretRef)
+		if err != nil {
+			return "", "", nil, fmt.Errorf("resolving connection secret for task %s/%s: %w", task.Namespace, task.Name, err)
+		}
+	}
+
+	return username, password, opts, nil
+}
+
+func (r *TaskReconciler) closeBMCClient(ctx context.Context, logger logr.Logger, bmcClient *bmclib.Client) {
+	if err := bmcClient.Close(ctx); err != nil {
+		md := bmcClient.GetMetadata()
+		logger.Error(err, "BMC close connection failed", "providersAttempted", md.ProvidersAttempted)
+
+		return
+	}
+	md := bmcClient.GetMetadata()
+	logger.Info("BMC connection closed", "successfulCloseConns", md.SuccessfulCloseConns, "providersAttempted", md.ProvidersAttempted, "successfulProvider", md.SuccessfulProvider)
+}
+
 // runTask executes the defined Task in a Task.
 func (r *TaskReconciler) runTask(ctx context.Context, logger logr.Logger, task bmc.Action, bmcClient *bmclib.Client) error {
 	if task.PowerAction != nil {
@@ -293,10 +450,106 @@ func (r *TaskReconciler) patchStatus(ctx context.Context, task *bmc.Task, patch
 	return nil
 }
 
+func (r *TaskReconciler) setHardOffActionAttemptedAt(ctx context.Context, task *bmc.Task, attemptedAt time.Time) error {
+	patch := client.MergeFrom(task.DeepCopy())
+	if task.Annotations == nil {
+		task.Annotations = map[string]string{}
+	}
+	task.Annotations[hardOffActionAttemptedAtAnnotation] = attemptedAt.UTC().Format(time.RFC3339Nano)
+	if err := r.client.Patch(ctx, task, patch); err != nil {
+		return fmt.Errorf("failed to patch Task %s/%s annotations: %w", task.Namespace, task.Name, err)
+	}
+
+	return nil
+}
+
+func (r *TaskReconciler) clearHardOffActionAttemptedAt(ctx context.Context, task *bmc.Task) error {
+	if _, ok := task.Annotations[hardOffActionAttemptedAtAnnotation]; !ok {
+		return nil
+	}
+
+	patch := client.MergeFrom(task.DeepCopy())
+	delete(task.Annotations, hardOffActionAttemptedAtAnnotation)
+	if err := r.client.Patch(ctx, task, patch); err != nil {
+		return fmt.Errorf("failed to patch Task %s/%s annotations: %w", task.Namespace, task.Name, err)
+	}
+
+	return nil
+}
+
+func hardOffActionAttemptedAt(task *bmc.Task) (time.Time, bool, error) {
+	value, ok := task.Annotations[hardOffActionAttemptedAtAnnotation]
+	if !ok {
+		return time.Time{}, false, nil
+	}
+
+	attemptedAt, err := time.Parse(time.RFC3339Nano, value)
+	if err != nil {
+		return time.Time{}, false, fmt.Errorf("invalid %s annotation: %w", hardOffActionAttemptedAtAnnotation, err)
+	}
+
+	return attemptedAt, true, nil
+}
+
+func hardOffRetryDelay(task *bmc.Task, now time.Time) time.Duration {
+	delay := hardOffRetryInitialInterval
+	if task.Status.StartTime != nil {
+		elapsed := now.Sub(task.Status.StartTime.Time)
+		for steps := int(elapsed / hardOffRetryStepInterval); steps > 0 && delay < hardOffRetryMaxInterval; steps-- {
+			delay *= 2
+			if delay > hardOffRetryMaxInterval {
+				delay = hardOffRetryMaxInterval
+			}
+		}
+	}
+
+	hash := fnv.New32a()
+	_, _ = hash.Write([]byte(string(task.UID)))
+	if task.UID == "" {
+		_, _ = hash.Write([]byte(task.Namespace + "/" + task.Name))
+	}
+	jitter := time.Duration(hash.Sum32()%uint32(hardOffRetryJitter/time.Second+1)) * time.Second
+	if delay+jitter > hardOffRetryMaxInterval {
+		return hardOffRetryMaxInterval
+	}
+
+	return delay + jitter
+}
+
+func isPowerHardOff(action bmc.Action) bool {
+	return action.PowerAction != nil && *action.PowerAction == bmc.PowerHardOff
+}
+
+func removeTaskCondition(task *bmc.Task, conditionType bmc.TaskConditionType) bool {
+	for i := range task.Status.Conditions {
+		if task.Status.Conditions[i].Type != conditionType {
+			continue
+		}
+		task.Status.Conditions = append(task.Status.Conditions[:i], task.Status.Conditions[i+1:]...)
+		return true
+	}
+
+	return false
+}
+
+func taskEventPredicate() predicate.Predicate {
+	return predicate.Funcs{
+		UpdateFunc: func(e event.UpdateEvent) bool {
+			oldTask, oldOK := e.ObjectOld.(*bmc.Task)
+			newTask, newOK := e.ObjectNew.(*bmc.Task)
+			if !oldOK || !newOK || !isPowerHardOff(newTask.Spec.Task) {
+				return true
+			}
+
+			return oldTask.Generation != newTask.Generation
+		},
+	}
+}
+
 // SetupWithManager sets up the controller with the Manager.
 func (r *TaskReconciler) SetupWithManager(mgr ctrl.Manager, opts ctrlcontroller.Options) error {
 	return ctrl.NewControllerManagedBy(mgr).
 		WithOptions(opts).
-		For(&bmc.Task{}).
+		For(&bmc.Task{}, builder.WithPredicates(taskEventPredicate())).
 		Complete(r)
 }

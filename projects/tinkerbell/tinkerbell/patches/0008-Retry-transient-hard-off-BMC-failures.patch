+func TestTaskReconcilePowerHardOffRetriesTransientFailures(t *testing.T) {
+	tests := map[string]struct {
+		includeSecret bool
+		provider      *testProvider
+		message       string
+	}{
+		"missing secret": {
+			provider: &testProvider{
+				Powerstate: "on",
+				PowerSetOK: true,
+			},
+			message: "resolving connection secret",
+		},
+		"connection failure": {
+			includeSecret: true,
+			provider: &testProvider{
+				ErrOpen: errors.New("temporary connection failure"),
+			},
+			message: "failed to connect to BMC",
+		},
+		"power state failure": {
+			includeSecret: true,
+			provider: &testProvider{
+				ErrPowerStateGet: errors.New("temporary power state failure"),
+			},
+			message: "failed to get power state",
+		},
+		"power command failure": {
+			includeSecret: true,
+			provider: &testProvider{
+				Powerstate:       "on",
+				ErrPowerStateSet: errors.New("temporary power command failure"),
+			},
+			message: "failed to perform PowerAction",
+		},
+		"power command rejected": {
+			includeSecret: true,
+			provider: &testProvider{
+				Powerstate: "on",
+				PowerSetOK: false,
+			},
+			message: "failed to perform PowerAction",
+		},
+	}
+
+	for name, tt := range tests {
+		t.Run(name, func(t *testing.T) {
+			secret := createSecret()
+			task := createTask("HardOff", getAction("HardOff"), secret)
+			builder := newClientBuilder().WithObjects(task)
+			if tt.includeSecret {
+				builder = builder.WithObjects(secret)
+			}
+			cluster := builder.Build()
+			reconciler := controller.NewTaskReconciler(cluster, newTestClient(tt.provider))
+			request := reconcile.Request{NamespacedName: types.NamespacedName{Namespace: task.Namespace, Name: task.Name}}
+
+			result, err := reconciler.Reconcile(context.Background(), request)
+			if err != nil {
+				t.Fatalf("expected retry without reconcile error, got: %v", err)
+			}
+			if result.RequeueAfter < 30*time.Second || result.RequeueAfter > 40*time.Second {
+				t.Fatalf("expected initial retry between 30s and 40s, got: %s", result.RequeueAfter)
+			}
+
+			retrieved := getTask(t, cluster, request.NamespacedName)
+			retrying := findTaskCondition(retrieved, bmc.TaskConditionType("Retrying"))
+			if retrying == nil || retrying.Status != bmc.ConditionTrue {
+				t.Fatalf("expected retrying condition, got: %+v", retrieved.Status.Conditions)
+			}
+			if !strings.Contains(retrying.Message, tt.message) {
+				t.Fatalf("expected retry message to contain %q, got %q", tt.message, retrying.Message)
+			}
+			if retrieved.HasCondition(bmc.TaskFailed, bmc.ConditionTrue) {
+				t.Fatalf("expected hard-off failure to remain retryable, got: %+v", retrieved.Status.Conditions)
+			}
+		})
+	}
+}

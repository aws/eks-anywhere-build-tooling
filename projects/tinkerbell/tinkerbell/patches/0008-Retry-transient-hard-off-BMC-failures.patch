+func findTaskCondition(task *bmc.Task, conditionType bmc.TaskConditionType) *bmc.TaskCondition {
+	for i := range task.Status.Conditions {
+		if task.Status.Conditions[i].Type == conditionType {
+			return &task.Status.Conditions[i]
+		}
+	}
+	return nil
+}
+
+func assertTaskCondition(t *testing.T, task *bmc.Task, conditionType bmc.TaskConditionType, status bmc.ConditionStatus) {
+	t.Helper()
+	condition := findTaskCondition(task, conditionType)
+	if condition == nil {
+		t.Fatalf("expected condition %s, got: %+v", conditionType, task.Status.Conditions)
+	}
+	if condition.Status != status {
+		t.Fatalf("expected condition %s status %s, got %s", conditionType, status, condition.Status)
+	}
+}

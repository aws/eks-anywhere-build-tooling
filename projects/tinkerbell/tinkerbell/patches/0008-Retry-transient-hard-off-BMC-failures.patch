+func getTask(t *testing.T, cluster client.Client, key types.NamespacedName) *bmc.Task {
+	t.Helper()
+	task := &bmc.Task{}
+	if err := cluster.Get(context.Background(), key, task); err != nil {
+		t.Fatalf("failed to get task: %v", err)
+	}
+	return task

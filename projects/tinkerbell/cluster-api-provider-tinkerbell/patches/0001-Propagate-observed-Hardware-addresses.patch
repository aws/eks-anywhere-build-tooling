+type observedStatusClient struct {
+	client.Client
+	observed *unstructured.Unstructured
+}
+
+func (c *observedStatusClient) Get(
+	ctx context.Context,
+	key client.ObjectKey,
+	obj client.Object,
+	opts ...client.GetOption,
+) error {
+	if observed, ok := obj.(*unstructured.Unstructured); ok {
+		c.observed.DeepCopyInto(observed)
+
+		return nil
+	}
+
+	return c.Client.Get(ctx, key, obj, opts...)
+}

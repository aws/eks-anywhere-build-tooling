-// hardwareIP returns the IP address of the first network interface of the given hardware.
+// hardwareIP returns the optional configured IP address of the first network interface.
 func hardwareIP(hardware *tinkv1.Hardware) (string, error) {
 	if hardware == nil {
 		return "", ErrHardwareIsNil
@@ -69,19 +76,64 @@ func hardwareIP(hardware *tinkv1.Hardware) (string, error) {
 		return "", ErrHardwareMissingInterfaces
 	}
 
-	if hardware.Spec.Interfaces[0].DHCP == nil {
-		return "", ErrHardwareFirstInterfaceNotDHCP
+	dhcp := hardware.Spec.Interfaces[0].DHCP
+	if dhcp == nil || dhcp.IP == nil || dhcp.IP.Address == "" {
+		return "", nil
 	}
 
-	if hardware.Spec.Interfaces[0].DHCP.IP == nil {
-		return "", ErrHardwareFirstInterfaceDHCPMissingIP
+	if _, err := netip.ParseAddr(dhcp.IP.Address); err != nil {
+		return "", fmt.Errorf("%w: %q", ErrHardwareFirstInterfaceDHCPInvalidIP, dhcp.IP.Address)
 	}
 
-	if hardware.Spec.Interfaces[0].DHCP.IP.Address == "" {
-		return "", ErrHardwareFirstInterfaceDHCPMissingIP
+	return dhcp.IP.Address, nil
+}
+
+func hardwareAddresses(ctx context.Context, c client.Client, hardware *tinkv1.Hardware) ([]corev1.NodeAddress, error) {
+	ip, err := hardwareIP(hardware)
+	if err != nil {
+		return nil, err
+	}
+	if ip != "" {
+		return []corev1.NodeAddress{{
+			Type:    corev1.NodeInternalIP,
+			Address: ip,
+		}}, nil
 	}
 
-	return hardware.Spec.Interfaces[0].DHCP.IP.Address, nil
+	observed := &unstructured.Unstructured{}
+	observed.SetGroupVersionKind(tinkv1.GroupVersion.WithKind("Hardware"))
+	if err := c.Get(ctx, client.ObjectKeyFromObject(hardware), observed); err != nil {
+		return nil, fmt.Errorf("getting observed Hardware status: %w", err)
+	}
+
+	items, found, err := unstructured.NestedSlice(observed.Object, "status", "addresses")
+	if err != nil {
+		return nil, fmt.Errorf("reading observed Hardware addresses: %w", err)
+	}
+	if !found {
+		return nil, nil
+	}
+
+	addresses := make([]corev1.NodeAddress, 0, len(items))
+	for _, item := range items {
+		value, ok := item.(map[string]interface{})
+		if !ok {
+			return nil, fmt.Errorf("observed Hardware address has unexpected type %T", item)
+		}
+
+		addressType, _, _ := unstructured.NestedString(value, "type")
+		address, _, _ := unstructured.NestedString(value, "address")
+		if _, err := netip.ParseAddr(address); err != nil {
+			return nil, fmt.Errorf("observed Hardware address is invalid: %q", address)
+		}
+
+		addresses = append(addresses, corev1.NodeAddress{
+			Type:    corev1.NodeAddressType(addressType),
+			Address: address,
+		})
+	}
+
+	return addresses, nil
 }
 

 controller/machine/hardware_test.go          | 194 +++++++++++++++++++
 controller/machine/scope.go                  |  12 +-
 controller/machine/tinkerbellmachine.go      |   5 +
 controller/machine/tinkerbellmachine_test.go |  31 ++-
 pkg/cluster/watch.go                         |   9 +-
 6 files changed, 308 insertions(+), 24 deletions(-)


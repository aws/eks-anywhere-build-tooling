+func TestHardwareIP(t *testing.T) {
+	t.Parallel()
+
+	tests := map[string]struct {
+		hardware      *tinkv1.Hardware
+		wantIP        string
+		wantError     error
+		wantErrorText string
+	}{
+		"nil hardware": {
+			wantError: ErrHardwareIsNil,
+		},
+		"missing interfaces": {
+			hardware:  &tinkv1.Hardware{},
+			wantError: ErrHardwareMissingInterfaces,
+		},
+		"missing DHCP configuration": {
+			hardware: hardwareWithInterface(tinkv1.Interface{}),
+		},
+		"missing DHCP IP configuration": {
+			hardware: hardwareWithInterface(tinkv1.Interface{DHCP: &tinkv1.DHCP{}}),
+		},
+		"empty DHCP IP address": {
+			hardware: hardwareWithInterface(tinkv1.Interface{DHCP: &tinkv1.DHCP{IP: &tinkv1.IP{}}}),
+		},
+		"valid IPv4 address": {
+			hardware: hardwareWithIP("192.0.2.10"),
+			wantIP:   "192.0.2.10",
+		},
+		"valid IPv6 address": {
+			hardware: hardwareWithIP("2001:db8::10"),
+			wantIP:   "2001:db8::10",
+		},
+		"malformed IP address": {
+			hardware:      hardwareWithIP("not-an-ip"),
+			wantError:     ErrHardwareFirstInterfaceDHCPInvalidIP,
+			wantErrorText: "not-an-ip",
+		},
+	}
+
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			t.Parallel()
+			g := NewWithT(t)
+
+			ip, err := hardwareIP(test.hardware)
+			if test.wantError != nil {
+				g.Expect(errors.Is(err, test.wantError)).To(BeTrue())
+				if test.wantErrorText != "" {
+					g.Expect(err).To(MatchError(ContainSubstring(test.wantErrorText)))
+				}
+
+				return
+			}
+
+			g.Expect(err).NotTo(HaveOccurred())
+			g.Expect(ip).To(Equal(test.wantIP))
+		})
+	}
+}
+
+func TestHardwareAddresses(t *testing.T) {
+	t.Parallel()
+
+	t.Run("configured address takes precedence", func(t *testing.T) {
+		t.Parallel()
+		g := NewWithT(t)
+
+		addresses, err := hardwareAddresses(context.Background(), nil, hardwareWithIP("192.0.2.10"))
+
+		g.Expect(err).NotTo(HaveOccurred())
+		g.Expect(addresses).To(Equal([]corev1.NodeAddress{{
+			Type:    corev1.NodeInternalIP,
+			Address: "192.0.2.10",
+		}}))
+	})
+
+	t.Run("returns observed address for addressless Hardware", func(t *testing.T) {
+		t.Parallel()
+		g := NewWithT(t)
+
+		hardware := hardwareWithInterface(tinkv1.Interface{})
+		hardware.Name = "hardware-1"
+		hardware.Namespace = "default"
+
+		observed := &unstructured.Unstructured{Object: map[string]interface{}{
+			"apiVersion": "tinkerbell.org/v1alpha1",
+			"kind":       "Hardware",
+			"metadata": map[string]interface{}{
+				"name":      hardware.Name,
+				"namespace": hardware.Namespace,
+			},
+			"status": map[string]interface{}{
+				"addresses": []interface{}{
+					map[string]interface{}{
+						"type":    string(corev1.NodeInternalIP),
+						"address": "2001:db8::10",
+					},
+				},
+			},
+		}}
+		observed.SetGroupVersionKind(tinkv1.GroupVersion.WithKind("Hardware"))
+		c := &observedStatusClient{
+			Client:   fake.NewClientBuilder().WithScheme(hardwareTestScheme(g)).Build(),
+			observed: observed,
+		}
+
+		addresses, err := hardwareAddresses(context.Background(), c, hardware)
+
+		g.Expect(err).NotTo(HaveOccurred())
+		g.Expect(addresses).To(Equal([]corev1.NodeAddress{{
+			Type:    corev1.NodeInternalIP,
+			Address: "2001:db8::10",
+		}}))
+	})
+
+	t.Run("rejects invalid observed address", func(t *testing.T) {
+		t.Parallel()
+		g := NewWithT(t)
+
+		hardware := hardwareWithInterface(tinkv1.Interface{})
+		hardware.Name = "hardware-1"
+		hardware.Namespace = "default"
+
+		observed := &unstructured.Unstructured{Object: map[string]interface{}{
+			"apiVersion": "tinkerbell.org/v1alpha1",
+			"kind":       "Hardware",
+			"metadata": map[string]interface{}{
+				"name":      hardware.Name,
+				"namespace": hardware.Namespace,
+			},
+			"status": map[string]interface{}{
+				"addresses": []interface{}{
+					map[string]interface{}{
+						"type":    string(corev1.NodeInternalIP),
+						"address": "not-an-ip",
+					},
+				},
+			},
+		}}
+		observed.SetGroupVersionKind(tinkv1.GroupVersion.WithKind("Hardware"))
+		c := &observedStatusClient{
+			Client:   fake.NewClientBuilder().WithScheme(hardwareTestScheme(g)).Build(),
+			observed: observed,
+		}
+
+		_, err := hardwareAddresses(context.Background(), c, hardware)
+
+		g.Expect(err).To(MatchError(ContainSubstring("not-an-ip")))
+	})
+}
+
+func hardwareWithInterface(networkInterface tinkv1.Interface) *tinkv1.Hardware {
+	return &tinkv1.Hardware{
+		Spec: tinkv1.HardwareSpec{
+			Interfaces: []tinkv1.Interface{networkInterface},
+		},
+	}
+}
+
+func hardwareWithIP(ip string) *tinkv1.Hardware {
+	return hardwareWithInterface(tinkv1.Interface{
+		DHCP: &tinkv1.DHCP{
+			IP: &tinkv1.IP{
+				Address: ip,
+			},
+		},
+	})
+}

From 448e4bb5c4e3cd6ab05e0e58d02768e860e0c028 Mon Sep 17 00:00:00 2001
From: Rahul Ganesh <rahulbabu95@gmail.com>
Date: Sat, 3 Oct 2026 08:59:26 +0000
Subject: [PATCH] Expose observed Hardware addresses in CRD

Store installed-OS addresses in Hardware status.
---
diff --git a/crd/bases/v1alpha1/tinkerbell.org_hardware.yaml b/crd/bases/v1alpha1/tinkerbell.org_hardware.yaml
index de686fee..9d6ded47 100644
--- a/crd/bases/v1alpha1/tinkerbell.org_hardware.yaml
+++ b/crd/bases/v1alpha1/tinkerbell.org_hardware.yaml
@@ -569,6 +569,24 @@ spec:
           status:
             description: HardwareStatus defines the observed state of Hardware.
             properties:
+              addresses:
+                description: Addresses contains network addresses observed for the
+                  installed operating system.
+                items:
+                  description: NodeAddress contains information for the node's address.
+                  properties:
+                    address:
+                      description: The node address.
+                      type: string
+                    type:
+                      description: Node address type, one of Hostname, ExternalIP
+                        or InternalIP.
+                      type: string
+                  required:
+                  - address
+                  - type
+                  type: object
+                type: array
               attributes:
                 description: |-
                   Attributes describes the hardware itself, as observed by Tinkerbell. It is
-- 
2.34.1

+func (o *HarborAPI) handler(operation string, next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		h := next
+		if b, ok := o.operationMiddlewares[operation]; ok {
+			h = b(h)
+		}
+
+		h.ServeHTTP(w, r)
+	})
+}
